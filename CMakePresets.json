{
  "version": 6,
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Unix harness Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/host/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "host-release",
      "displayName": "Unix harness Release",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build/host/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "stm32-debug",
      "displayName": "STM32F103C8 Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/stm32c8/debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RICECOOKER_BUILD_STM32": "ON"
      }
    },
    {
      "name": "stm32-release",
      "displayName": "STM32F103C8 Release",
      "inherits": "stm32-debug",
      "binaryDir": "${sourceDir}/build/stm32c8/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "host-debug", "configurePreset": "host-debug", "jobs": 0 },
    { "name": "host-release", "configurePreset": "host-release", "jobs": 0 },
    { "name": "stm32-debug", "configurePreset": "stm32-debug", "jobs": 0 },
    { "name": "stm32-release", "configurePreset": "stm32-release", "jobs": 0 }
  ]
}
