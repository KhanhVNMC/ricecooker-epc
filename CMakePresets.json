{
  "version": 6,
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Unix harness Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/artifacts/host/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "host-release",
      "displayName": "Unix harness Release",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/artifacts/host/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "stm32f1c8-debug",
      "displayName": "STM32F103C8 Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/artifacts/stm32f1c8/debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RICECOOKER_BUILD_STM32": "ON"
      }
    },
    {
      "name": "stm32f1c8-release",
      "displayName": "STM32F1C8 MCU Release",
      "inherits": "stm32f1c8-debug",
      "binaryDir": "${sourceDir}/artifacts/stm32f1c8/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "stm32f1c8-release-proteus",
      "displayName": "STM32F1C8 with Proteus 8.17 CLZ Workarounds Release",
      "inherits": "stm32f1c8-release",
      "binaryDir": "${sourceDir}/artifacts/stm32f1c8/proteus-release",
      "cacheVariables": {
        "COMPILED_FOR_PROTEUS_8_17": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "host-debug", "configurePreset": "host-debug", "jobs": 0 },
    { "name": "host-release", "configurePreset": "host-release", "jobs": 0 },
    { "name": "stm32f1c8-debug", "configurePreset": "stm32f1c8-debug", "jobs": 0 },
    { "name": "stm32f1c8-release", "configurePreset": "stm32f1c8-release", "jobs": 0 },
    { "name": "stm32f1c8-release-proteus", "configurePreset": "stm32f1c8-release-proteus", "jobs": 0 }
  ]
}
